# Live AI provider: anthropic (default) or openrouter.
# Keep credentials blank unless the matching provider is selected.
AI_PROVIDER=anthropic

# Direct Anthropic API credential (used only when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenRouter API credential and model (used only when AI_PROVIDER=openrouter).
# The worker derives ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN for the
# Claude Agent SDK; do not set those values here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~anthropic/claude-sonnet-latest

# Research execution
RESEARCH_MODE=fixtures
AGENT_MODEL=sonnet
AGENT_MAX_TURNS=8
AGENT_MAX_BUDGET_USD=0.50
AGENT_TIMEOUT_MS=120000
AGENT_DUPLICATE_ACTION_LIMIT=2
AGENT_NO_PROGRESS_ACTION_LIMIT=3
WEB_SEARCH_MAX_USES=2
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_MAX_TOKENS=1200
WEB_SEARCH_TIMEOUT_MS=30000
MAX_CONCURRENT_RESEARCH_JOBS=1

# Browser automation
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
BROWSER_MAX_PAGES_PER_RUN=10

# Local database
DATABASE_URL=file:./data/commerce-scout.db

# Application
NEXT_PUBLIC_APP_NAME=CommerceScout AI
