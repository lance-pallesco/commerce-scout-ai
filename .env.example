# Anthropic API
ANTHROPIC_API_KEY=

# Research execution
RESEARCH_MODE=fixtures
AGENT_MODEL=sonnet
AGENT_MAX_TURNS=8
AGENT_MAX_BUDGET_USD=0.50
AGENT_TIMEOUT_MS=120000
AGENT_MAX_RETRIES=2
AGENT_DUPLICATE_ACTION_LIMIT=2
AGENT_NO_PROGRESS_ACTION_LIMIT=3
MAX_CONCURRENT_RESEARCH_JOBS=1

# Browser automation
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
BROWSER_MAX_PAGES_PER_RUN=10

# Local database
DATABASE_URL=file:./data/commerce-scout.db

# Application
NEXT_PUBLIC_APP_NAME=CommerceScout AI
